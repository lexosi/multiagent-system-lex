{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/session-start-substitute-paths.ps1\"",
            "timeout": 60,
            "statusMessage": "Resolving multiagent placeholders..."
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/session-start-substitute-paths.ps1\"",
            "timeout": 60,
            "statusMessage": "Resolving multiagent placeholders..."
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/session-start-substitute-paths.ps1\"",
            "timeout": 60,
            "statusMessage": "Resolving multiagent placeholders..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/session-start-substitute-paths.ps1\"",
            "timeout": 60,
            "statusMessage": "Resolving multiagent placeholders..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/userpromptsubmit-visibility-reminder.ps1\"",
            "timeout": 5,
            "statusMessage": "Visibility reminder..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/stop-knowledge-curator.ps1\"",
            "timeout": 30,
            "statusMessage": "Scanning AR for curator pending..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/stop-no-auditor.ps1\"",
            "timeout": 30,
            "statusMessage": "Scanning AR for auditor pending..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/stop-capture-skills-token-tax.ps1\"",
            "timeout": 30,
            "statusMessage": "Capturing skills token tax..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-guard-protected-files.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-guard-protected-files.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-guard-protected-files.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-guard-protected-files.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-verse-kb-advisory.ps1\"",
            "timeout": 10,
            "statusMessage": "Verse KB advisory check..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-block-scope-territory.ps1\"",
            "timeout": 10,
            "statusMessage": "Scope-territory hard-block check..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<repo_root>/hooks/pretooluse-capture-task-invocation.ps1\"",
            "timeout": 10,
            "statusMessage": "Capturing task invocation (Fase 5.1)..."
          }
        ]
      }
    ]
  }
}
